{
  "metadata": {
    "version": "2.0",
    "name": "功能医学两段式健康评估问卷",
    "stage1Description": "23题整体健康评估，映射7大核心生理过程失衡。",
    "stage2Description": "根据Stage1评分，仅对主要异常领域呈现15题深入评估。",
    "scoringMethod": "计算每个失衡领域对应整体问题中'是'的百分比，按百分比降序排列。",
    "selectionRule": "阳性率≥30%的领域进入Stage2详细评估；若均低于30%，则取阳性率最高的1个领域。"
  },
  "sections": [
    {
      "id": "basic",
      "title": "基本信息",
      "subtitle": "请填写您的基本信息",
      "stage": "info",
      "questions": [
        {
          "qid": "basic_name",
          "text": "您的姓名",
          "type": "text",
          "placeholder": "请输入姓名"
        },
        {
          "qid": "basic_gender",
          "text": "您的性别",
          "type": "radio",
          "options": [
            "男",
            "女"
          ]
        },
        {
          "qid": "basic_age",
          "text": "您的年龄",
          "type": "number",
          "placeholder": "岁"
        },
        {
          "qid": "basic_phone",
          "text": "联系电话",
          "type": "text",
          "placeholder": "手机号码（自动填入）"
        },
        {
          "qid": "basic_height",
          "text": "您的身高",
          "type": "number",
          "placeholder": "厘米（cm）"
        },
        {
          "qid": "basic_weight",
          "text": "您的体重",
          "type": "number",
          "placeholder": "公斤（kg）"
        },
        {
          "qid": "basic_source",
          "text": "您由何渠道前来（来源）",
          "type": "text",
          "placeholder": "如：门诊/朋友介绍/网络等"
        },
        {
          "qid": "basic_labor",
          "text": "您的劳动强度",
          "type": "radio",
          "options": [
            "轻体力劳动",
            "中体力劳动",
            "重体力劳动"
          ]
        }
      ]
    },
