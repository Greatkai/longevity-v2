# JWT 签名密钥（生产环境务必替换为高强度随机字符串）
JWT_SECRET=please-change-me-to-a-long-random-secret-string

# PostgreSQL 数据库连接串（Vercel + Supabase 部署必填）
# 在 Supabase 的 Project Settings -> Database -> Connection string 获取
# 推荐使用 "Session pooler" / pgbouncer 连接串以适配 serverless
# 示例：postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chi_longevity

# 是否启用 SSL（Supabase 通常为 true，本地可为 false）
DATABASE_SSL=true

# 管理员初始账号（首次访问管理后台时自动创建）
ADMIN_EMAIL=admin@chi.cn
ADMIN_PASSWORD=change-me-in-production

# AI 服务（可选，不配置则使用本地规则兜底）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
